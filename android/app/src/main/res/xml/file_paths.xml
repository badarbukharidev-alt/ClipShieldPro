<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths the FileProvider may hand to another app.

  root-path is deliberate. Renders live under getApplicationDocumentsDirectory(),
  which path_provider maps to context.getDir("flutter") -> /data/user/0/<pkg>/
  app_flutter, which is covered by NO specific tag: files-path is
  getFilesDir() (a sibling), and the external-* tags are elsewhere entirely.
  Listing only those made getUriForFile() throw "Failed to find configured root"
  for every rendered clip, which surfaced as "the app would not accept the file"
  on every direct share.

  The exposure this opens is narrow: the provider is not exported, nothing is
  readable without a URI we mint ourselves, and each grant is per-share and
  transient. An app cannot enumerate anything through it.
-->
<paths>
    <root-path name="root" path="/" />
    <files-path name="internal_files" path="." />
    <cache-path name="internal_cache" path="." />
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-path name="external_storage" path="." />
</paths>
